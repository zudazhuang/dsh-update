{
  "name": "dsh-update-safe",
  "version": "0.4.1",
  "description": "DeepSeek Harness 源码安装的更新插件：官方版本检查、隔离构建、试启动健康检查、监督切换与失败回滚（supervised source update with rollback）",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "engine.js",
    "store.js",
    "supervisor.mjs",
    "cordis.patch.yml",
    "README.md",
    "start-harness.sh",
    "schedule.js",
    "install-login-start.py"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "semver": "7.7.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4 || 4.0.5-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.4 || 3.18.5-alpha.1",
    "react": ">=18 <19"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/schemastery": "3.18.4",
    "react": "18.3.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zudazhuang/dsh-update-safe.git"
  },
  "homepage": "https://github.com/zudazhuang/dsh-update-safe#readme",
  "bugs": {
    "url": "https://github.com/zudazhuang/dsh-update-safe/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-update",
    "dsh-update-safe",
    "deepseek-harness",
    "deepseek-harness-update",
    "updater",
    "self-update",
    "rollback",
    "supervisor",
    "更新",
    "更新插件",
    "源码安装"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
